<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 联网权限：安装时自动授予，不用运行时申请 / Network access: granted at install time, no runtime request -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- android:name 指定自定义 Application，它持有全 App 的 AppContainer / android:name points at the custom Application, which holds the app's AppContainer -->
    <!-- localeConfig：Android 13+ 系统设置里可以单独给 App 选语言，选项见 locale_config.xml / localeConfig: lets Android 13+ system settings pick a language for this app alone, from the choices in locale_config.xml -->
    <application
        android:name=".SteaLApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locale_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.SteaL">
        <!-- 启动时用带启动画面的主题，MainActivity 的 installSplashScreen() 再换回 Theme.SteaL / Starts with the splash theme; installSplashScreen() in MainActivity switches back to Theme.SteaL -->
        <!-- configChanges="uiMode"：深浅变化（系统切换、App 调 setApplicationNightMode）不重建 Activity，由 Compose 按设置重画；重建会闪一帧黑屏 / configChanges="uiMode": light/dark changes (system switch, or the app calling setApplicationNightMode) don't recreate the Activity, Compose redraws from the settings instead; recreating flashes a black frame -->
        <!-- locale|layoutDirection：Android 13+ 改 App 语言时也不重建，Compose 读新的 LocalConfiguration 重画（两项要一起写，换语言可能改文字方向）；12 及以下由 AppLocaleController 主动 recreate，不受这里影响 / locale|layoutDirection: changing the app language on Android 13+ doesn't recreate either, Compose redraws from the new LocalConfiguration (both are needed, as a new language can change the text direction); on 12 and earlier AppLocaleController calls recreate itself, which ignores this -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.SteaL.Starting"
            android:configChanges="uiMode|locale|layoutDirection"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>