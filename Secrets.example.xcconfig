// 复制为 Secrets.xcconfig 并填入自己的 key / Copy to Secrets.xcconfig and fill in your own keys
ITAD_API_KEY =
LLM_API_KEY =
// OpenAI Chat Completions 兼容的服务商；xcconfig 里 // 是注释，URL 要写成 https:/$()/ / Any OpenAI-compatible provider; `//` starts a comment here, so write URLs as https:/$()/
LLM_API_URL = https:/$()/api.deepseek.com
LLM_MODEL = deepseek-flash
